@{
    Layout = null; // Ortak şablonu iptal et, üst menüyü gizle!
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - Haber Portalı</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-md-4 mt-5">
                <div class="card shadow-lg border-0 rounded-lg">
                    <div class="card-header bg-dark text-white text-center">
                        <h4 class="font-weight-light my-2">Yönetici Girişi</h4>
                    </div>
                    <div class="card-body">
                        <form id="loginForm">
                            <div class="mb-3">
                                <label class="form-label">Kullanıcı Adı</label>
                                <input type="text" id="txtUserName" class="form-control" placeholder="admin" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Şifre</label>
                                <input type="password" id="txtPassword" class="form-control" placeholder="******" required />
                            </div>
                            <button type="button" id="btnLogin" class="btn btn-dark w-100">Giriş Yap</button>
                        </form>
                        <div id="resultMessage" class="mt-3 text-center fw-bold"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
        $("#btnLogin").click(function () {
        var loginData = {
        userName: $("#txtUserName").val(),
        password: $("#txtPassword").val()
        };

        $.ajax({
       
        url: "https://localhost:7253/api/Auth/login",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(loginData),
        success: function (response) {
        localStorage.setItem("token", response.token);
        $("#resultMessage").removeClass("text-danger").addClass("text-success").text("Giriş başarılı! Yönlendiriliyorsunuz...");
                        
        setTimeout(function() {
        window.location.href = "/Home/Index"; 
        }, 1500);
        },
        error: function (xhr) {
        $("#resultMessage").removeClass("text-success").addClass("text-danger").text("Bağlantı hatası veya yanlış şifre!");
        }
        });
        });
        });
    </script>
</body>
</html>