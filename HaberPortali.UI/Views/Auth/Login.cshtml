@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Giriş Yap - Haber Mozaik</title>
    
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    
    <style>
        body { 
            background-color: #f4f6f9; 
            font-family: 'Nunito', sans-serif; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            min-height: 100vh; 
            margin: 0;
        }
        .auth-card { 
            background: #fff; 
            border-radius: 4px; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.08); 
            width: 100%; 
            max-width: 400px; 
            overflow: hidden; 
            border: none; 
        }
        .auth-header { background-color: #212529; color: #fff; padding: 20px; text-align: center; }
        .auth-header h3 { margin: 0; font-weight: 600; font-size: 1.4rem; letter-spacing: 0.5px; }
        .auth-body { padding: 30px; }
        .form-group label { font-size: 0.9rem; color: #333; margin-bottom: 5px; }
        .form-control { background-color: #edf2fa; border: 1px solid #d1d3e2; padding: 10px 15px; border-radius: 4px; }
        .form-control:focus { background-color: #fff; border-color: #212529; box-shadow: none; }
        .btn-dark-custom { background-color: #212529; color: #fff; width: 100%; padding: 10px; font-weight: 400; border-radius: 4px; border: none; transition: 0.3s; font-size: 1rem;}
        .btn-dark-custom:hover { background-color: #1a1d20; color: #fff; }
    </style>
</head>
<body>

    <div class="auth-card">
        <div class="auth-header">
            <h3>Sisteme Giriş</h3>
        </div>
        <div class="auth-body">
            
            <div id="alertArea"></div>
            
            <form id="loginForm">
                <div class="form-group">
                    <label>Kullanıcı Adı</label>
                    <input type="text" id="logUsername" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Şifre</label>
                    <input type="password" id="logPassword" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-dark-custom mt-3" id="btnLogin">Giriş Yap</button>
            </form>

            <div class="text-center mt-4">
                <a href="/Auth/Register" class="text-muted small text-decoration-none">Hesabın yok mu? <span class="text-dark font-weight-bold">Kayıt Ol</span></a>
            </div>
            
        </div>
    </div>

   <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        
        $("#loginForm").submit(function (e) {
            e.preventDefault();
            
            var btn = $("#btnLogin");
            btn.text('Bekleniyor...').prop("disabled", true);

            var loginData = {
                userName: $("#logUsername").val(),
                password: $("#logPassword").val()
            };

            $.ajax({
                url: "https://localhost:7253/api/Auth/login", 
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(loginData),
                success: function (response) {
                    
                    var token = response.token;
                    localStorage.setItem("token", token);

                    try {
                        var base64Url = token.split('.')[1];
                        var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                        var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                        }).join(''));
                        
                        var payload = JSON.parse(jsonPayload);

                        var role = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || 
                                   payload.role || 
                                   payload.roles || 
                                   "Rol Bulunamadı!";

                        var roleStr = Array.isArray(role) ? role.join(",") : String(role);
                        var rolKucukHarf = roleStr.toLowerCase();

                        if (rolKucukHarf.includes("admin") || rolKucukHarf.includes("yönetici")) {
                            window.location.href = "/Dashboard/Index";
                        } else {
                            window.location.href = "/Web/Index";
                        }

                    } catch (e) {
                        alert("Token okunamadı! Hata: " + e.message);
                        window.location.href = "/Web/Index";
                    }
                },
                error: function () {
                    btn.text('Giriş Yap').prop("disabled", false);
                    $("#alertArea").html('<div class="alert alert-danger small">Kullanıcı adı veya şifre hatalı!</div>');
                }
            });
        });

    });
</script>
</body>
</html>