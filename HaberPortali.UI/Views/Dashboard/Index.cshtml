@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Haber Mozaik - Yönetim Paneli</title>

    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
        <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
        <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
        </head>

        <body id="page-top">

            <div id="wrapper">

                <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
                    <a class="sidebar-brand d-flex align-items-center justify-content-center" href="#">
                        <div class="sidebar-brand-icon rotate-n-15"><i class="fas fa-newspaper"></i></div>
                        <div class="sidebar-brand-text mx-3">Haber Mozaik</div>
                    </a>
                    <hr class="sidebar-divider my-0">
            
                    <li class="nav-item active">
                        <a class="nav-link" href="/Dashboard/Index">
                            <i class="fas fa-fw fa-tachometer-alt"></i>
                            <span>Ana Panel</span>
                        </a>
                    </li>

                    <hr class="sidebar-divider">

                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-fw fa-list"></i><span>Kategoriler</span></a></li>
                    <li class="nav-item"><a class="nav-link" href="/News/Index"><i class="fas fa-fw fa-file-alt"></i><span>Haberler</span></a></li>
                    <li class="nav-item"><a class="nav-link" href="/Comments/Index"><i class="fas fa-fw fa-comments"></i><span>Yorumlar</span></a></li>
                    <li class="nav-item"><a class="nav-link" href="/Users/Index"><i class="fas fa-fw fa-users"></i><span>Kullanıcılar</span></a></li>
            
                    <hr class="sidebar-divider d-none d-md-block">
                </ul>

                <div id="content-wrapper" class="d-flex flex-column">
                    <div id="content">

                        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                            <ul class="navbar-nav ml-auto">
                                <li class="nav-item dropdown no-arrow">
                                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown">
                                        <span class="mr-2 d-none d-lg-inline text-gray-600 small font-weight-bold">Yönetici</span>
                                        <img class="img-profile rounded-circle" src="~/img/undraw_profile.svg">
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in">
                                            <a class="dropdown-item" href="#" id="btnLogout">
                                                <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i> Çıkış Yap
                                            </a>
                                        </div>
                                    </li>
                                </ul>
                            </nav>

                            <div class="container-fluid">
                                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                                    <h1 class="h3 mb-0 text-gray-800">Sistem Özeti</h1>
                                </div>

                                <div class="row">

                                    <div class="col-xl-3 col-md-6 mb-4">
                                        <div class="card border-left-primary shadow h-100 py-2">
                                            <div class="card-body">
                                                <div class="row no-gutters align-items-center">
                                                    <div class="col mr-2">
                                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Toplam Haber</div>
                                                        <div class="h5 mb-0 font-weight-bold text-gray-800" id="statTotalNews">...</div>
                                                    </div>
                                                    <div class="col-auto">
                                                        <i class="fas fa-newspaper fa-2x text-gray-300"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6 mb-4">
                                        <div class="card border-left-success shadow h-100 py-2">
                                            <div class="card-body">
                                                <div class="row no-gutters align-items-center">
                                                    <div class="col mr-2">
                                                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Aktif Kategoriler</div>
                                                        <div class="h5 mb-0 font-weight-bold text-gray-800" id="statTotalCategories">...</div>
                                                    </div>
                                                    <div class="col-auto">
                                                        <i class="fas fa-list fa-2x text-gray-300"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6 mb-4">
                                        <div class="card border-left-info shadow h-100 py-2">
                                            <div class="card-body">
                                                <div class="row no-gutters align-items-center">
                                                    <div class="col mr-2">
                                                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Kayıtlı Kullanıcılar</div>
                                                        <div class="h5 mb-0 font-weight-bold text-gray-800" id="statTotalUsers">...</div>
                                                    </div>
                                                    <div class="col-auto">
                                                        <i class="fas fa-users fa-2x text-gray-300"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3 col-md-6 mb-4">
                                        <div class="card border-left-warning shadow h-100 py-2">
                                            <div class="card-body">
                                                <div class="row no-gutters align-items-center">
                                                    <div class="col mr-2">
                                                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Onay Bekleyen Yorum</div>
                                                        <div class="h5 mb-0 font-weight-bold text-gray-800" id="statPendingComments">...</div>
                                                    </div>
                                                    <div class="col-auto">
                                                        <i class="fas fa-comments fa-2x text-gray-300"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="card shadow mb-4">
                                            <div class="card-header py-3">
                                                <h6 class="m-0 font-weight-bold text-primary">Haber Mozaik Paneline Hoş Geldiniz</h6>
                                            </div>
                                            <div class="card-body">
                                                <p>Sol menüyü kullanarak sisteminizdeki içerikleri yönetebilir, yeni haberler ekleyebilir ve kullanıcı etkileşimlerini kontrol edebilirsiniz. Yukarıdaki özet kartları sisteminizin anlık istatistiklerini yansıtmaktadır.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <footer class="sticky-footer bg-white">
                            <div class="container my-auto">
                                <div class="copyright text-center my-auto">
                                    <span>Copyright &copy; Haber Mozaik 2026</span>
                                </div>
                            </div>
                        </footer>
                    </div>
                </div>

                <script src="~/vendor/jquery/jquery.min.js"></script>
                <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
                <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
                <script src="~/js/sb-admin-2.min.js"></script>

                <script>
                        $(document).ready(function () {
                            var userToken = localStorage.getItem("token");
                            if (!userToken) { window.location.href = "/Auth/Login"; return; }

                            var apiStatsUrl = "https://localhost:7253/api/Dashboard/stats";

                            function loadStats() {
                                $.ajax({
                                    url: apiStatsUrl,
                                    type: "GET",
                                    headers: { "Authorization": "Bearer " + userToken },
                                    success: function (data) {
                                        $("#statTotalNews").text(data.totalNews);
                                        $("#statTotalCategories").text(data.totalCategories);
                                        $("#statTotalUsers").text(data.totalUsers);
                                        $("#statPendingComments").text(data.pendingComments);
                                    },
                                    error: function () {
                                        console.log("İstatistikler çekilirken bir hata oluştu.");
                                    }
                                });
                            }

                            $("#btnLogout").click(function () {
                                localStorage.removeItem("token");
                                window.location.href = "/Auth/Login";
                            });

                            loadStats();
                        });
                </script>
            </body>
        </html>