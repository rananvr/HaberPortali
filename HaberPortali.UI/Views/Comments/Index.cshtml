@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Haber Portalı - Yorum Yönetimi</title>

    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
        <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
        <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
        </head>

        <body id="page-top">

            <div id="wrapper">

                <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
                    <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/Dashboard/Index">
                        <div class="sidebar-brand-icon rotate-n-15"><i class="fas fa-newspaper"></i></div>
                        <div class="sidebar-brand-text mx-3">Haber Mozaik</div>
                    </a>
    
                    <hr class="sidebar-divider my-0">

                    <li class="nav-item">
                        <a class="nav-link" href="/Dashboard/Index">
                            <i class="fas fa-fw fa-tachometer-alt"></i>
                            <span>Ana Panel</span>
                        </a>
                    </li>

                    <hr class="sidebar-divider">
    
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Index">
                            <i class="fas fa-fw fa-list"></i>
                            <span>Kategoriler</span>
                        </a>
                    </li>
    
                    <li class="nav-item">
                        <a class="nav-link" href="/News/Index">
                            <i class="fas fa-fw fa-file-alt"></i>
                            <span>Haberler</span>
                        </a>
                    </li>
    
                    <li class="nav-item">
                        <a class="nav-link" href="/Comments/Index">
                            <i class="fas fa-fw fa-comments"></i>
                            <span>Yorumlar</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Users/Index">
                            <i class="fas fa-fw fa-users"></i>
                            <span>Kullanıcılar</span>
                        </a>
                    </li>

                    <hr class="sidebar-divider d-none d-md-block">
                </ul>

                <div id="content-wrapper" class="d-flex flex-column">
                    <div id="content">

                        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                            <ul class="navbar-nav ml-auto">
                                <li class="nav-item dropdown no-arrow">
                                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown">
                                        <span class="mr-2 d-none d-lg-inline text-gray-600 small">Yönetici</span>
                                        <img class="img-profile rounded-circle" src="~/img/undraw_profile.svg">
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                                            <a class="dropdown-item" href="#" id="btnLogout">
                                                <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i> Çıkış Yap
                                            </a>
                                        </div>
                                    </li>
                                </ul>
                            </nav>

                            <div class="container-fluid">
                                <h1 class="h3 mb-4 text-gray-800">Yorum Yönetimi</h1>
                    
                                <div id="alertArea"></div>

                                <div class="card shadow mb-4">
                                    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                        <h6 class="m-0 font-weight-bold text-primary">Kullanıcı Yorumları</h6>
                                        <button class="btn btn-sm btn-primary" id="btnRefreshComments">
                                            <i class="fas fa-sync-alt fa-sm text-white-50"></i> Listeyi Yenile
                                        </button>
                                    </div>
                                    <div class="card-body">
                            
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-hover align-middle" id="commentsTable">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th width="150">Kullanıcı</th>
                                                        <th width="200">Haber Başlığı</th>
                                                        <th>Yorum İçeriği</th>
                                                        <th width="100">Durum</th>
                                                        <th width="180">İşlemler</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr><td colspan="5" class="text-center text-muted">Yükleniyor...</td></tr>
                                                </tbody>
                                            </table>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <footer class="sticky-footer bg-white">
                            <div class="container my-auto">
                                <div class="copyright text-center my-auto">
                                    <span>Copyright &copy; Haber Portalı 2026</span>
                                </div>
                            </div>
                        </footer>
                    </div>
                </div>

                <script src="~/vendor/jquery/jquery.min.js"></script>
                <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
                <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
                <script src="~/js/sb-admin-2.min.js"></script>

                <script>
                        $(document).ready(function () {
                            var userToken = localStorage.getItem("token");
                            if (!userToken) { window.location.href = "/Auth/Login"; return; }

                            var apiCommentsUrl = "https://localhost:7253/api/Comments";

                            function showMessage(message, type) {
                                var alertHtml = `<div class="alert alert-${type} alert-dismissible fade show shadow-sm" role="alert">
                                                    <strong>Bilgi:</strong> ${message}
                                                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                                                 </div>`;
                                $("#alertArea").html(alertHtml);
                                setTimeout(function () { $(".alert").alert('close'); }, 3000);
                            }

                            // 1. Yorumları Çek ve Tabloya Doldur
                            function loadComments() {
                                $.ajax({
                                    url: apiCommentsUrl,
                                    type: "GET",
                                    headers: { "Authorization": "Bearer " + userToken },
                                    success: function (data) {
                                        var tbody = $("#commentsTable tbody");
                                        tbody.empty();
                        
                                        if (data.length === 0) {
                                            tbody.append('<tr><td colspan="5" class="text-center">Sistemde henüz hiç yorum yok.</td></tr>');
                                            return;
                                        }

                                        $.each(data, function (index, item) {
                                            var userName = item.user && item.user.userName ? item.user.userName : "Bilinmeyen Kullanıcı";
                                            var newsTitle = item.news && item.news.title ? item.news.title : "<span class='text-danger'>Haber Silinmiş</span>";
                            
                                            var statusBadge = item.isApproved
                                                ? '<span class="badge badge-success">Onaylı</span>'
                                                : '<span class="badge badge-secondary">Gizli</span>';
                                
                                            var toggleBtnClass = item.isApproved ? "btn-warning" : "btn-success";
                                            var toggleBtnIcon = item.isApproved ? "fa-eye-slash" : "fa-check";
                                            var toggleBtnText = item.isApproved ? "Gizle" : "Onayla";

                                            var tr = `
                                                <tr>
                                                    <td class="font-weight-bold text-primary">${userName}</td>
                                                    <td class="small text-dark">${newsTitle}</td>
                                                    <td>${item.content}</td>
                                                    <td class="text-center">${statusBadge}</td>
                                                    <td>
                                                        <button class="btn btn-sm ${toggleBtnClass} btn-toggle-comment" data-id="${item.id}">
                                                            <i class="fas ${toggleBtnIcon}"></i> ${toggleBtnText}
                                                        </button>
                                                        <button class="btn btn-sm btn-danger btn-delete-comment ml-1" data-id="${item.id}">
                                                            <i class="fas fa-trash"></i> Sil
                                                        </button>
                                                    </td>
                                                </tr>`;
                                            tbody.append(tr);
                                        });
                                    }
                                });
                            }

                            // 2. Yorumu Onayla / Gizle İşlemi
                            $(document).on("click", ".btn-toggle-comment", function () {
                                var id = $(this).data("id");
                
                                $.ajax({
                                    url: apiCommentsUrl + "/approve/" + id,
                                    type: "PUT",
                                    headers: { "Authorization": "Bearer " + userToken },
                                    success: function (response) {
                                        showMessage(response.message, "success");
                                        loadComments(); 
                                    },
                                    error: function () {
                                        showMessage("İşlem sırasında bir hata oluştu.", "danger");
                                    }
                                });
                            });

                            // 3. Yorum Silme İşlemi
                            $(document).on("click", ".btn-delete-comment", function () {
                                var id = $(this).data("id");
                
                                if (confirm("Bu yorumu tamamen silmek istediğinize emin misiniz?")) {
                                    $.ajax({
                                        url: apiCommentsUrl + "/" + id,
                                        type: "DELETE",
                                        headers: { "Authorization": "Bearer " + userToken },
                                        success: function () {
                                            showMessage("Yorum kalıcı olarak silindi!", "success");
                                            loadComments();
                                        }
                                    });
                                }
                            });

                            $("#btnRefreshComments").click(function() {
                                loadComments();
                            });

                            $("#btnLogout").click(function () {
                                localStorage.removeItem("token");
                                window.location.href = "/Auth/Login";
                            });

                            loadComments();
                        });
                </script>
            </body>
        </html>