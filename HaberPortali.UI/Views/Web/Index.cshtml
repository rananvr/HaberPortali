@{
    Layout = "~/Views/Shared/_WebLayout.cshtml";
    ViewData["Title"] = "Ana Sayfa";
}

<style>
    .main-headline {
        width: 100%;
        height: 450px; 
        background-color: #f1f3f9;
        position: relative;
        overflow: hidden;
        border-radius: 5px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 30px;
        display: block; 
    }
    .main-headline img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
    .main-headline:hover img { transform: scale(1.05); } 
    .main-headline-overlay {
        position: absolute; bottom: 0; left: 0; right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.95), transparent);
        padding: 50px 40px 30px 40px;
        text-align: center;
    }
    .main-headline h2 { color: #fff; font-weight: 900; font-size: 2.5rem; text-shadow: 2px 2px 5px #000; margin:0;}

    .section-title { font-weight: 900; font-size: 1.5rem; color: #000; text-transform: uppercase; margin-bottom: 10px; text-align: center;}
    .title-border { border-bottom: 2px solid #eaecf4; margin-bottom: 30px; padding-bottom: 10px; }

    .custom-news-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
        width: 100%;
    }

    .ht-card { 
        position: relative; 
        height: 250px; 
        overflow: hidden; 
        display: block; 
        border-radius: 5px; 
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .ht-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
    .ht-card:hover img { transform: scale(1.08); }
    
    .ht-overlay {
        position: absolute; bottom: 0; left: 0; right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 70%, transparent 100%);
        padding: 25px 20px 15px 20px;
        text-align: center;
    }
    .ht-title { color: #f6c23e; font-weight: 800; font-size: 1.15rem; line-height: 1.3; margin: 0; text-shadow: 1px 1px 3px rgba(0,0,0,0.9); }
    .ht-title span { color: #fff; }

    /* Ekran küçülünce bozulmasın diye */
    @@media (max-width: 992px) { .custom-news-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 768px) { .custom-news-grid { grid-template-columns: 1fr; } }
</style>

<div class="row mx-0">
    <div class="col-12 px-0">
        <div id="mainHeadline">
            <div class="main-headline d-flex justify-content-center align-items-center">
                <div class="spinner-border text-primary"></div>
            </div>
        </div>
    </div>
</div>

<div class="row mx-0">
    <div class="col-12 px-0">
        <div class="title-border">
            <h3 class="section-title">Günün Önemli Gelişmeleri</h3>
        </div>
    </div>
</div>

<div class="custom-news-grid" id="newsGrid">
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            
            var apiNewsUrl = "https://localhost:7253/api/News";
            var apiCategoriesUrl = "https://localhost:7253/api/Categories";

            // Kategorileri Çek
            $.ajax({
                url: apiCategoriesUrl,
                type: "GET",
                success: function (data) {
                    var menu = $("#publicCategoryMenu");
                    $.each(data, function (index, item) {
                        menu.append(`<li><a class="nav-link" href="/Web/Category/${item.id}">${item.name}</a></li>`);
                    });
                }
            });

            // Haberleri Çek
            $.ajax({
                url: apiNewsUrl,
                type: "GET",
                success: function (data) {
                    var mainHeadline = $("#mainHeadline");
                    var grid = $("#newsGrid");
                    
                    grid.empty();

                    if (data.length === 0) return;

                    $.each(data, function (index, item) {
                        var imgUrl = item.imageUrl ? "https://localhost:7253" + item.imageUrl : "https://dummyimage.com/800x600/4e73df/fff.png&text=Gorsel";

                        // HABERLERİN İLKİ: ANA MANŞET OLARAK
                        if (index === 0) {
                            mainHeadline.html(`
                                <a href="/Web/Detail/${item.id}" class="main-headline text-decoration-none">
                                    <img src="${imgUrl}" alt="">
                                    <div class="main-headline-overlay"><h2>${item.title}</h2></div>
                                </a>
                            `);
                        } 
                        // 3 HABER KARTI OLARAK
                        else {
                            var words = item.title.split(" ");
                            var firstHalf = words.slice(0, Math.ceil(words.length / 2)).join(" ");
                            var secondHalf = words.slice(Math.ceil(words.length / 2)).join(" ");

                            var cardHtml = `
                                <a href="/Web/Detail/${item.id}" class="ht-card text-decoration-none">
                                    <img src="${imgUrl}" alt="">
                                    <div class="ht-overlay">
                                        <p class="ht-title">${firstHalf} <span>${secondHalf}</span></p>
                                    </div>
                                </a>
                            `;
                            grid.append(cardHtml);
                        }
                    });
                }
            });

        });
    </script>
}